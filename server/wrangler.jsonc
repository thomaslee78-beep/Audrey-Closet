{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "audrey-smartscan-api",
  "main": "smartscan-worker.js",
  "compatibility_date": "2026-09-08",
  "observability": {
    "enabled": true
  },
  "vars": {
    "SMARTSCAN_DAILY_LIMIT": "30"
  },
  "secrets": {
    "required": ["OPENAI_API_KEY"]
  }
}
